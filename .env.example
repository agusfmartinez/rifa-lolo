# URLs de las pestañas publicadas del Google Sheet (Archivo > Compartir > Publicar en la web > CSV)
# Si quedan vacías, la web usa los datos de ejemplo de docs/datos-ejemplo/
VITE_CSV_PUBLICO=
VITE_CSV_RESUMEN=

# Opcional: URL pública del sitio (ej. https://rifa-lolo.netlify.app), para que la
# imagen al compartir por WhatsApp sea absoluta. En Netlify se completa sola.
VITE_SITE_URL=
